# PostgreSQL connection string (SQLAlchemy URL, psycopg3 driver)
DATABASE_URL=postgresql+psycopg://orbit:orbit@localhost:5432/orbit
# Long random string used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=43200
# Max records returned per /sync/pull page
SYNC_PAGE_SIZE=500
CORS_ORIGINS=*
