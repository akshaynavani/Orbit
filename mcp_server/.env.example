# Where the Orbit backend is running
ORBIT_API_URL=http://localhost:8000
# Either a long-lived JWT ...
ORBIT_TOKEN=
# ... or credentials the server uses to log in at startup
ORBIT_EMAIL=
ORBIT_PASSWORD=
# Optional: minutes east of UTC used to interpret "tomorrow at 5pm" (defaults to the host's timezone)
ORBIT_TZ_OFFSET_MINUTES=
